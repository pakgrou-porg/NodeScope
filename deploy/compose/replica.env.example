# Copy to replica.env on each server replica. Keep replica.env outside Git.
# Framework uses the preferred values; Asus uses the secondary values.

NODESCOPE_REPLICA_ID=framework
NODESCOPE_REPLICA_ROLE=preferred
NODESCOPE_PRIMARY_ENDPOINT=https://10.116.2.145:8443
NODESCOPE_SECONDARY_ENDPOINT=https://10.116.2.56:8443
NODESCOPE_SUPABASE_URL=https://YOUR_SHARED_PROJECT.supabase.co
NODESCOPE_RUNTIME_DB_HOST=db.YOUR_SHARED_PROJECT.supabase.co
NODESCOPE_RUNTIME_DB_PORT=5432
NODESCOPE_RUNTIME_DB_NAME=postgres
NODESCOPE_RUNTIME_DB_USER=nodescope_runtime_login
NODESCOPE_RUNTIME_SECRETS_FILE=/srv/nodescope/runtime/runtime.env

# Do not place database passwords, service-role keys, agent secrets, or CA
# private keys here. The runtime.env file in the protected runtime directory
# supplies NODESCOPE_RUNTIME_DB_PASSWORD; mount other server-only material there.
NODESCOPE_BIND_ADDRESS=0.0.0.0
NODESCOPE_TLS_PORT=8443
NODESCOPE_CERTIFICATE_DIRECTORY=/srv/nodescope/certs
NODESCOPE_RUNTIME_DIRECTORY=/srv/nodescope/runtime
NODESCOPE_IMAGE_TAG=edge
